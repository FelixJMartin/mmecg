# PTB-XL raw waveform data - large, re-downloadable via PhysioNet, metadata csv/txt files stay tracked
ptb-xl/*.h5
ptb-xl/records100/
ptb-xl/records500/

# trained model weights - large, regenerable by rerunning train.py
unet-src/checkpoints/

# generated dataset is regenerable from ptb-xl/ptb_preprocessed.h5 via make_mask.py -
# don't bloat the repo with it (README's demo images live in readme_assets/ instead)
unet-src/data/imgs/*
unet-src/data/masks/*
unet-src/data/test_imgs/*
unet-src/data/test_masks/*

# staging area for cluster uploads - regenerable, not meant to be committed
cluster_upload/

# Python build/cache cruft
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# local tooling / env state
.claude/
wandb/
venv/
.venv/
.vscode/
.idea/

